diff --git a/app/src/main/res/drawable-v21/preference_list_divider_material.xml b/app/src/main/res/drawable-v21/preference_list_divider_material.xml
new file mode 100644
index 0000000..3b6d6d9
--- /dev/null
+++ b/app/src/main/res/drawable-v21/preference_list_divider_material.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- OP7 r6: neutralize androidx preference list dividers. Rows are now inset
+     cards separated by pure-black gaps; full-width divider lines would cross
+     the card margins. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android">
+    <solid android:color="@android:color/transparent" />
+    <size
+        android:height="1dp"
+        android:width="1dp" />
+</shape>
diff --git a/app/src/main/res/drawable/op7_preference_row_background.xml b/app/src/main/res/drawable/op7_preference_row_background.xml
new file mode 100644
index 0000000..ccf76bf
--- /dev/null
+++ b/app/src/main/res/drawable/op7_preference_row_background.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- OP7 r6: preference row card surface (AMOLED dark). Solid fill uses
+     ?attr/colorSurfaceContainer (#1A1A1A in values-night/colors.xml) so rows
+     stay visible on the pure-black settings backdrop; ripple keeps press
+     feedback. Same token as home cards (layer_color_2) for a consistent look. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="?attr/colorControlHighlight">
+    <item>
+        <shape android:shape="rectangle">
+            <solid android:color="?attr/colorSurfaceContainer" />
+            <corners android:radius="12dp" />
+        </shape>
+    </item>
+</ripple>
