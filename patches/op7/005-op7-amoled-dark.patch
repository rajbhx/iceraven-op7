diff --git a/app/src/main/res/drawable/op7_preference_row_background.xml b/app/src/main/res/drawable/op7_preference_row_background.xml
new file mode 100644
index 0000000..d41621f
--- /dev/null
+++ b/app/src/main/res/drawable/op7_preference_row_background.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- OP7 r7: preference row card on the AMOLED dark settings page. Fill uses
+     ?attr/colorSurfaceContainer (pure black in values-night/colors.xml) so the
+     row melts into the pure-black backdrop; a 1dp hairline stroke (#242424)
+     keeps the card structure visible without lighting AMOLED pixels. Ripple
+     keeps press feedback. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="?attr/colorControlHighlight">
+    <item>
+        <shape android:shape="rectangle">
+            <solid android:color="?attr/colorSurfaceContainer" />
+            <stroke
+                android:width="1dp"
+                android:color="#FF242424" />
+            <corners android:radius="12dp" />
+        </shape>
+    </item>
+</ripple>
